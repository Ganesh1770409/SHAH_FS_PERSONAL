# Copy to .env for local runs (never commit .env). On Render, set variables in the Web Service → Environment.
SECRET_KEY=use-a-long-random-string-here

# PostgreSQL (Render): paste the **External Database URL** from your Postgres instance
# (Dashboard → Connect). Linking the DB to the Web Service also injects DATABASE_URL automatically.
# From your laptop, use the external URL and usually add ?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
