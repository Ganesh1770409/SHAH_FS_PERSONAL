# Copy to .env for local runs (never commit .env).
SECRET_KEY=use-a-long-random-string-here

# --- AWS RDS MySQL (matches: mysql -h ... -P 3306 -u admin -p --ssl-mode=VERIFY_IDENTITY --ssl-ca=./global-bundle.pem) ---
MYSQL_HOST=shahfs.clisiamk4coy.ap-south-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your-rds-password
MYSQL_DATABASE=shahfs
MYSQL_SSL_CA=./global-bundle.pem
MYSQL_SSL_VERIFY_IDENTITY=true

# Or single URL (URL-encode special characters in the password):
# DATABASE_URL=mysql+pymysql://admin:PASSWORD@shahfs.clisiamk4coy.ap-south-1.rds.amazonaws.com:3306/shahfs

# --- Render (Web Service → Environment): copy MYSQL_* above + SECRET_KEY ---
# Include global-bundle.pem in the repo or build step; set MYSQL_SSL_CA to its path on the server.
# RDS security group must allow inbound 3306 from Render (or 0.0.0.0/0 for testing only).
# On first deploy the app runs CREATE DATABASE IF NOT EXISTS for MYSQL_DATABASE (needs CREATE privilege).
# Or create manually: CREATE DATABASE shahfs CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Signups on your Render URL INSERT into the `users` table in this database (persists across redeploys).

# --- Password reset email (required for /forgot-password) ---
# APP_BASE_URL=https://your-app.onrender.com
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_DEFAULT_SENDER=your@gmail.com
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# Do NOT use your normal Gmail sign-in password in MAIL_PASSWORD.
# Set the same MAIL_* values on Render (Environment), then redeploy.

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_DIR=logs
# LOG_TO_FILE=true
# On Render: logs stream to Dashboard → Logs (stdout). Optional LOG_TO_FILE=true writes ephemeral files.
# Locally: tail -f logs/app.log  and  logs/error.log
