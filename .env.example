# Copy to .env for local runs (never commit .env). On your host, set DATABASE_URL in the dashboard.
SECRET_KEY=use-a-long-random-string-here

# MySQL (recommended for this project). Use mysql+pymysql:// or plain mysql:// (normalized automatically).
# charset=utf8mb4 supports full Unicode including emoji in text fields.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4

# Optional: public MySQL with SSL (many clouds require ssl parameters—see your provider’s docs).
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4&ssl_ca=/path/to/ca.pem
